{
  module: {
    name: 'entry',
    type: 'entry',
    srcEntry: './ets/Application/AbilityStage.ets',
    description: '$string:app_name',
    mainElement: 'EntryAbility',
    deviceTypes: ['phone', 'tablet', '2in1'],
    requestPermissions: [
      { name: 'ohos.permission.INTERNET' },
      // onPrepareToTerminate(): the system tray's mandatory 退出 row arrives
      // there; vetoing once lets the app disconnect all sessions and remove the
      // tray icon before terminateSelf(). normal / system_grant (install-time).
      { name: 'ohos.permission.PREPARE_APP_TERMINATE' },
      // system_basic / user_grant restricted permission; allowed by the ACL in
      // the TianGuanDebugDevicesACLDebug signing profile.
      { name: 'ohos.permission.READ_PASTEBOARD',
        reason: '$string:module_desc',
        usedScene: { abilities: ['EntryAbility','RemoteAbility'], when: 'inuse' } }
    ],
    deliveryWithInstall: true,
    installationFree: false,
    pages: '$profile:main_pages',
    abilities: [
      {
        name: 'EntryAbility',
        srcEntry: './ets/entryability/EntryAbility.ets',
        description: '$string:app_name',
        icon: '$media:layered_image',
        startWindowIcon: '$media:layered_image',
        startWindowBackground: '$color:start_window_background',
        label: '$string:app_name',
        // Follow the device orientation; the list layout switches on its own
        // window width (onAreaChange), so rotating re-lays it out.
        orientation: 'auto_rotation',
        exported: true,
        skills: [{ entities: ['entity.system.home'], actions: ['ohos.want.action.home'] }]
      },
      {
        // One independent instance per remote session. launchType "multiton"
        // gives each startAbility its own task and top-level window, so the
        // system window picker (clicked Dock icon) lists the main window and
        // every session as directly activatable cards. Not exported: only this
        // application's own main ability starts it.
        name: 'RemoteAbility',
        srcEntry: './ets/remote/RemoteAbility.ets',
        description: '$string:app_name',
        icon: '$media:layered_image',
        startWindowIcon: '$media:layered_image',
        startWindowBackground: '$color:start_window_background',
        label: '$string:app_name',
        // Rotate with the phone like the main window. On a desktop display this
        // is inert; the session window keeps the size RemoteAbility gives it.
        orientation: 'auto_rotation',
        exported: false,
        launchType: 'multiton'
      }
    ]
  }
}
